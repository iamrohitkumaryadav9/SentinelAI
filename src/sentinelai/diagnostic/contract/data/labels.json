    "mem.events.oom_kill",
    "mem.reclaim.target",
    "mem.refault.target",
    "mem.majfault.target"
   ],
   "definition": "memory PSI above PSI_MEM_MIN and baseline, or oom_kill > 0, or reclaim with refault/majfault",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "AB.R1",
   "label": "application_bottleneck",
   "role": "required",
   "uses_baseline": true,
   "features": [
    "app.queue_wait_ms",
    "app.lock_wait_ms",
    "app.dependency_latency_ms",
    "app.pool_rejections",
    "app.events"
   ],
   "definition": "positive application-saturation predicate (queue/lock/dependency wait, pool rejections, closed-set events)",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "AB.R2",
   "label": "application_bottleneck",
   "role": "required",
