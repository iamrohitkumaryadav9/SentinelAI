    "app.queue_wait_ms",
    "app.lock_wait_ms",
    "app.dependency_latency_ms",
    "app.pool_rejections",
    "app.events"
   ],
   "definition": "application-level wait explains >= APP_SHARE_MIN of the p99 latency increase",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
