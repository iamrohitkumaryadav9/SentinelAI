{
 "contract_version": "0.3.0-draft",
 "labels": {
  "cpu_contention": {
   "confusable": [
    "cpu_throttling",
    "softirq_overload"
   ]
  },
  "cpu_throttling": {
   "confusable": [
    "cpu_contention"
   ]
  },
  "softirq_overload": {
   "confusable": [
    "cpu_contention",
    "network_packet_loss"
   ]
  },
  "network_packet_loss": {
   "confusable": [
    "tcp_retransmissions",
    "softirq_overload"
   ]
  },
  "tcp_retransmissions": {
   "confusable": [
    "network_packet_loss"
   ]
  },
  "memory_pressure": {
   "confusable": [
    "application_bottleneck"
   ]
  },
  "application_bottleneck": {
   "confusable": [
    "memory_pressure",
    "cpu_contention",
    "cpu_throttling"
   ],
   "positive_evidence_features": [
    "app.queue_wait_ms",
    "app.lock_wait_ms",
    "app.dependency_latency_ms",
    "app.pool_rejections",
    "app.events"
   ],
   "never_sufficient_features": [
    "app.latency_ms",
    "app.error_rate"
   ]
  }
 },
 "clauses": [
  {
   "clause_id": "CC.R1",
   "label": "cpu_contention",
   "role": "required",
   "uses_baseline": true,
   "features": [
    "sched.run_delay_excess.target",
    "sched.run_delay.target",
    "throttle.time_rate"
   ],
   "definition": "DEV(sched.run_delay_excess.target): waiting beyond what quota throttling explains",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "CC.R2",
   "label": "cpu_contention",
   "role": "required",
   "uses_baseline": true,
   "features": [
    "cpu.util.cpuset",
    "cpu.steal.cpuset"
   ],
   "definition": "ABS(cpu.util.cpuset, SAT_MIN) or DEV(cpu.steal.cpuset)",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "CC.X1",
   "label": "cpu_contention",
   "role": "contradictory",
   "uses_baseline": false,
   "features": [
    "throttle.ratio"
   ],
   "definition": "throttle.ratio >= THR_RATIO_MIN (resolved by PR-3)",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "CC.X2",
   "label": "cpu_contention",
   "role": "contradictory",
   "uses_baseline": false,
   "features": [
    "softirq.relevant_cpu_max",
    "softirq.frac.percpu",
    "cpu.util.cpuset"
   ],
   "definition": "softirq dominance on relevant CPUs, SI_SHARE_MIN met (resolved by PR-5)",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "CT.R1",
   "label": "cpu_throttling",
   "role": "required",
   "uses_baseline": false,
   "features": [
    "throttle.quota_limited"
   ],
   "definition": "a finite quota exists (throttle.quota_limited == 1)",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "CT.R2",
   "label": "cpu_throttling",
   "role": "required",
   "uses_baseline": true,
   "features": [
    "throttle.ratio",
    "throttle.time_rate"
   ],
   "definition": "ABS(throttle.ratio, THR_RATIO_MIN) and DEV(throttle.time_rate)",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "SI.R1",
   "label": "softirq_overload",
   "role": "required",
   "uses_baseline": true,
   "features": [
    "softirq.relevant_cpu_max",
    "softirq.frac.percpu"
   ],
   "definition": "ABS(softirq.relevant_cpu_max, SI_ABS_MIN) and DEV(softirq.frac.percpu) on the same CPU with ratio >= SI_RATIO_MIN",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "SI.R2",
   "label": "softirq_overload",
   "role": "required",
   "uses_baseline": true,
   "features": [
    "sched.run_delay_excess.target",
    "psi.cpu.some.target"
   ],
   "definition": "impact on target: DEV(sched.run_delay_excess.target) or DEV(psi.cpu.some.target)",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "PL.R1",
   "label": "network_packet_loss",
   "role": "required",
   "uses_baseline": true,
   "features": [
    "net.drop.qdisc",
    "net.drop.iface_rx",
    "net.drop.iface_tx",
    "net.err.iface",
    "net.drop.softnet",
    "net.drop.socket",
    "net.drop.netfilter",
    "net.drop.kfree_skb",
    "net.pkts.iface"
   ],
   "definition": "LOSS.LOCAL: a local drop source exceeds DROP_ABS_MIN, deviates from baseline and DROP_FRAC_MIN",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "RT.R0",
   "label": "tcp_retransmissions",
   "role": "required",
   "uses_baseline": false,
   "features": [
    "tcp.out_segs_rate"
   ],
   "definition": "tcp.out_segs_rate >= SEG_MIN",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "RT.R1",
   "label": "tcp_retransmissions",
   "role": "required",
   "uses_baseline": true,
   "features": [
    "tcp.retrans_frac",
    "tcp.retrans_rate",
    "tcp.out_segs_rate",
    "tcp.timeouts_rate"
   ],
   "definition": "ABS(tcp.retrans_frac, RT_FRAC_MIN) and DEV(tcp.retrans_frac); DEV(tcp.timeouts_rate) may substitute",
   "components": [
    {
     "type": "item",
     "sub": null,
     "kind": "POSITIVE"
    }
   ]
  },
  {
   "clause_id": "RT.R2",
   "label": "tcp_retransmissions",
   "role": "primary",
   "uses_baseline": true,
   "features": [
    "net.drop.qdisc",
    "net.drop.iface_rx",
    "net.drop.iface_tx",
    "net.err.iface",
    "net.drop.softnet",
    "net.drop.socket",
    "net.drop.netfilter",
    "net.drop.kfree_skb",
    "net.pkts.iface"
   ],
   "definition": "EVALUATED(min_local_drop_set) and LOSS.LOCAL is FALSE; Primary clause: required for tcp_retransmissions to be the decision, not for it to be CONTRIBUTING under PR-1",
   "components": [
    {
     "type": "item",
     "sub": "EVALUATED",
     "kind": "POSITIVE"
    },
    {
     "type": "item",
     "sub": "LOSS.LOCAL",
     "kind": "NEGATIVE"
    }
   ],
   "subordinate": {
    "rule": "PR-1",
    "primary": "network_packet_loss"
   }
  },
  {
   "clause_id": "MP.R1",
   "label": "memory_pressure",
   "role": "required",
   "uses_baseline": true,
   "features": [
