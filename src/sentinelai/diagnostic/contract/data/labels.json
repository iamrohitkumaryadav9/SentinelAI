 ],
 "precedence": [
  {
   "rule_id": "PR-1",
   "labels": [
    "network_packet_loss",
    "tcp_retransmissions"
   ],
   "resolution": "primary network_packet_loss; contributing tcp_retransmissions"
  },
  {
   "rule_id": "PR-2",
   "labels": [
    "softirq_overload",
    "network_packet_loss"
   ],
   "resolution": "if all qualifying drops are softnet drops on softirq-saturated CPUs (or kfree_skb CPU_BACKLOG): primary softirq_overload; contributing network_packet_loss"
  },
  {
   "rule_id": "PR-2b",
   "labels": [
    "softirq_overload",
    "network_packet_loss"
   ],
   "resolution": "drops from any non-softnet source: CONFLICT_UNRESOLVED"
  },
  {
   "rule_id": "PR-3",
   "labels": [
    "cpu_throttling",
    "cpu_contention"
   ],
   "resolution": "primary = larger of throttle.time_rate and sched.run_delay_excess.target if larger >= DOM_RATIO x smaller; else conflict"
  },
  {
   "rule_id": "PR-4",
   "labels": [
    "cpu_contention",
    "cpu_throttling",
    "softirq_overload",
    "network_packet_loss",
    "tcp_retransmissions",
    "memory_pressure",
    "application_bottleneck"
   ],
   "resolution": "application_bottleneck not assertable when any infrastructure label is assertable (AB.R3)"
  },
  {
   "rule_id": "PR-5",
   "labels": [
    "softirq_overload",
    "cpu_contention"
   ],
   "resolution": "primary softirq_overload if softirq share of busy time on relevant CPUs >= SI_SHARE_MIN; else cpu_contention if CC.R1 holds without the softirq CPUs; else conflict"
  }
 ]
}
