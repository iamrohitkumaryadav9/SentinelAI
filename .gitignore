# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime output (keep directory markers only)
logs/*
!logs/.gitkeep
results/**/raw/

# eBPF build output (vmlinux.h, BPF object, skeleton, binaries): regenerated by `make -C ebpf`
ebpf/build/

# Model weights / large artifacts never go into git
*.gguf
*.safetensors
*.bin

# Secrets / local overrides
.env
*.local

# M5 pilot transport copies (AMD-27): lg/ is the load generator's client.jsonl, byte-identical to the
# manifest-covered evidence/client.jsonl; collector/ is the unprivileged collector's output, copied into evidence/
results/phase1c_m5_pilot/*/*/lg/
results/phase1c_m5_pilot/*/*/collector/
# M6 staging (FZ-M6-PLAN): run directories before `m6.py pack`; only the packed raw dataset is committed
results/phase1c_m6/
